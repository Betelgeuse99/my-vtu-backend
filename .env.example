# ============================================================
# Dreamhatcher VTU backend — env template (NO real values)
# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Render is being decommissioned (750-hr free-tier limit). These same
# variables move to: 1) GitHub repo secrets (for the deploy workflow) and
# 2) Supabase Edge Function secrets. See supabase/functions/.env.example.
# ============================================================

PORT=3000

# Supabase
